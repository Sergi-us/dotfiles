#!/bin/sh
## 2026-09-01   SARBS
# Abhängigkeiten: GNU Coreutils (cat, cut, head, mkdir, tail), awk, bc, gsettings, info, pidof, pstree, sed, tree, xrandr, xrdb
# Zentrale DPI/Skalierungs-Konfiguration für X11-Sitzungen.
# Massgeblich ist immer der Primaerbildschirm: berechnet dessen Hardware-DPI,
# wendet DISPLAY_ADJUST an, setzt State-Dateien und konfiguriert xrandr +
# Umgebungsvariablen.
#
# Aufruf:
#   set-dpi           Interaktiver Modus - zeigt Werte, fragt vor Anwendung
#   set-dpi -s        Start/Silent - für xprofile (setzt alles ohne Ausgabe)
#   set-dpi -a        Apply - wendet sofort an ohne Rueckfrage (für Skripte)
#   set-dpi -d        Dry-Run - zeigt nur berechnete Werte, aendert nichts
#   set-dpi -j N      Justierung fest auf N% setzen und anwenden (persistent)
#   set-dpi -j auto   Automatische Justierung nach Bildschirmgroesse aktivieren
#
# Stellschrauben (Umgebungsvariablen ueberschreiben alles):
#   FORCE_DPI=192      Ueberspringt Auto-Erkennung + Adjust komplett
#   FORCE_SCALE=1.25   Ueberspringt Scale-Ableitung
#
# Cursor-Anpassung (apply_dpi):
#   gsettings          Sofort wirksam fuer GTK3/GTK4-Apps
#   xrdb -merge + xsetroot  X11-Root-Cursor (wirkt bei neuen Apps)
#   gtk-*.ini          Persistente Config fuer neu gestartete Apps
#   HINWEIS: Qt-Apps benoetigen einen Neustart um die Groesse zu uebernehmen

# === Default für DISPLAY_ADJUST ===
# "auto": Justierung wird ueber AUTO_ADJUST_RULES anhand des Primaerbildschirms
# bestimmt. Greift wenn die State-Datei noch nicht existiert (frisches System)
# oder via "set-dpi -j auto" gesetzt wurde.
DISPLAY_ADJUST_DEFAULT="auto"

# === Automatische Justierung nach Primaerbildschirm ===
# Regel-Tabelle, eine Zeile pro Regel. Aufbau: "<max_zoll>|<min_px_breite>|<adjust_prozent>"
#   max_zoll       Bildschirmdiagonale hoechstens (Zoll, gerundet)
#   min_px_breite  horizontale Aufloesung mindestens (Pixel)
# Die Zeilen werden von oben nach unten geprueft, erste passende Regel gewinnt.
# Ohne Treffer gilt AUTO_ADJUST_FALLBACK.
# WICHTIG: Spezifische Regeln (hohe min_px_breite bzw. kleine max_zoll) nach
# oben, breite Auffangregeln nach unten. Ohne EDID-Daten ist die Diagonale 0
# und wuerde sonst in die erste (kleine) Zoll-Klasse fallen.
#
# --- Feinjustierung: Weitere Regeln einfach als eigene Zeile ergaenzen ---
# Beispiele (bei Bedarf einkommentieren bzw. anpassen, Reihenfolge beachten):
#   32|3800|60      4K bis 32 Zoll etwas zurueckhaltender (+60%)
#   24|2500|50      2.5K auch auf kleineren Monitoren (z.B. 24 Zoll) +50%
#   24|1900|25      FullHD ueber 20 Zoll leicht vergroessern (+25%)
#   99|0|-10        Auffangregel: alles uebrige leicht verkleinern (-10%)
# Tipp: Die kaufmaennisch gerundete Diagonale des Primaerbildschirms zeigt
# "set-dpi -d" an - so lassen sich Regeln gezielt zuschneiden.
# Default: 4K +75%, 2.5K am 27-Zoller +50%, Laptop bis 14 Zoll ohne Justierung.
AUTO_ADJUST_RULES="
99|3800|75
27|2500|75
14|1900|0
"
AUTO_ADJUST_FALLBACK=0

# === Source-sicher: return statt exit wenn gesourced ===
# Wenn via ". set-dpi -s" eingebunden, wuerde exit die aufrufende Shell beenden.
# Erkennung: "return" in einer Subshell gelingt nur in gesourceden Skripten.
if (return 0 2>/dev/null); then
	_setdpi_quit() { return "${1:-0}"; }
else
	_setdpi_quit() { exit "${1:-0}"; }
fi

# === State-Verzeichnis ===
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/xsession"

# === Modus bestimmen ===
MODE="interactive"
case "$1" in
	-s|--start)  MODE="silent" ;;
	-a|--apply)  MODE="apply" ;;
	-d|--dry-run) MODE="dryrun" ;;
	-j|--justify)
		# Justierung setzen und sofort anwenden
		shift
		case "$1" in
			auto) ;;
			''|*[!0-9-]*) echo "Fehler: -j erwartet eine Ganzzahl oder 'auto' (z.B. set-dpi -j -15)"; _setdpi_quit 1 ;;
		esac
		[ -d "$state_dir" ] || mkdir -p "$state_dir"
		echo "$1" > "$state_dir/adjust"
		MODE="apply" ;;
	-h|--help)
		echo "Verwendung: set-dpi [-s|-a|-d|-j N|-j auto|-h]"
		echo "  (ohne)   Interaktiver Modus"
		echo "  -s       Start/Silent (für xprofile)"
		echo "  -a       Apply (sofort anwenden)"
		echo "  -d       Dry-Run (nur anzeigen)"
		echo "  -j N     Justierung fest auf N% setzen und anwenden"
		echo "           z.B. set-dpi -j -15  oder  set-dpi -j 0"
		echo "  -j auto  Automatische Justierung nach Bildschirmgroesse"
		echo "           (Regeln: AUTO_ADJUST_RULES im Skript)"
		echo "  -h       Diese Hilfe"
		echo ""
		echo "Aktueller DISPLAY_ADJUST: $(cat "$state_dir/adjust" 2>/dev/null || echo "$DISPLAY_ADJUST_DEFAULT")"
		_setdpi_quit 0 ;;
	"") ;;
	*) echo "Unbekannte Option: $1 (siehe set-dpi -h)"; _setdpi_quit 1 ;;
esac

# === DISPLAY_ADJUST laden ===
# Prioritaet: 1. State-Datei (persistent, via -j gesetzt) 2. Default aus Skript
DISPLAY_ADJUST=$(cat "$state_dir/adjust" 2>/dev/null) && [ -n "$DISPLAY_ADJUST" ] || DISPLAY_ADJUST=$DISPLAY_ADJUST_DEFAULT
# Validierung: Ganzzahl oder "auto"
case "$DISPLAY_ADJUST" in
	auto) ;;
	''|*[!0-9-]*) DISPLAY_ADJUST=$DISPLAY_ADJUST_DEFAULT ;;
esac

# === Display-Erkennung ===

# Ermittelt das massgebliche Display (Primaerbildschirm) und liefert
# "name|aufloesung|physische_groesse" zurueck. Berechnung und Ausgabe
# verwenden dieselbe Funktion, damit beides zusammenpasst.
# Strategie:
# 1. Primary mit aktiver Aufloesung (+X+Y Position)
# 2. Erstes aktives Display mit Aufloesung (z.B. Primary ist der
#    zugeklappte Laptop ohne aktives Signal)
# 3. Primary ohne aktive Aufloesung (native Mode wird verwendet)
# 4. Erstes verbundenes Display
get_display_info() {
	_info=$(xrandr 2>/dev/null | grep " connected primary" | grep -E '[0-9]+x[0-9]+\+[0-9]+')
	[ -z "$_info" ] && _info=$(xrandr 2>/dev/null | grep " connected" | grep -E '[0-9]+x[0-9]+\+[0-9]+' | head -n 1)
	[ -z "$_info" ] && _info=$(xrandr 2>/dev/null | grep " connected primary")
	[ -z "$_info" ] && _info=$(xrandr 2>/dev/null | grep " connected" | head -n 1)
	[ -z "$_info" ] && { echo "||"; return; }

	_name=$(echo "$_info" | awk '{print $1}')
	_res=$(echo "$_info" | grep -oE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' | head -n 1 | cut -d'+' -f1)

	# Falls keine aktive Aufloesung: erste (native) Mode aus der Liste holen
	if [ -z "$_res" ]; then
		_res=$(xrandr 2>/dev/null | grep -A 1 "^$_name " | tail -n 1 | awk '{print $1}')
	fi
	case "$_res" in
		[0-9]*x[0-9]*) ;;
		*) _res="" ;;
	esac

	_phys=$(echo "$_info" | grep -oE '[0-9]+mm x [0-9]+mm')
	echo "$_name|$_res|$_phys"
}

# Wartet bis xrandr fuer mindestens ein aktives Display die physische Groesse
# meldet (EDID gelesen). Direkt nach einem Display-Wechsel kann die Angabe
# kurz fehlen; ohne sie ist keine sinnvolle DPI-Berechnung moeglich.
# Kurzes Polling (max. 3 Sekunden), damit Login/Wechsel nicht haengen bleibt.
wait_for_display_size() {
	_w=0
	while [ "$_w" -lt 6 ]; do
		xrandr 2>/dev/null | grep " connected" | grep -E '[0-9]+x[0-9]+\+[0-9]+' | grep -q '[0-9]*mm x [0-9]*mm' && return 0
		sleep 0.5 2>/dev/null || return 0
		_w=$((_w + 1))
	done
}

# === DPI-Berechnung ===

# Roh-DPI (nicht gerundet) aus Pixelbreite und physischer Breite in mm
calculate_raw_dpi() {
	_px_w=$1
	_mm_w=$2
	[ -n "$_px_w" ] && [ -n "$_mm_w" ] || { echo 96; return; }
	[ "$_mm_w" -gt 0 ] 2>/dev/null || { echo 96; return; }
	_dpi=$(echo "scale=0; ($_px_w * 25.4) / $_mm_w" | bc 2>/dev/null)
	echo "${_dpi:-96}"
}

# Bildschirmdiagonale in Zoll (kaufmaennisch gerundet)
calculate_diagonal() {
	_mm_w=$1
	_mm_h=$2
	[ "$_mm_w" -gt 0 ] 2>/dev/null && [ "$_mm_h" -gt 0 ] 2>/dev/null || { echo 0; return; }
	echo "scale=2; d1 = sqrt($_mm_w * $_mm_w + $_mm_h * $_mm_h) / 25.4; scale=0; (d1 + 0.5) / 1" | bc 2>/dev/null
}

# Automatische Justierung anhand AUTO_ADJUST_RULES
# $1 = Pixelbreite, $2 = Diagonale in Zoll
auto_adjust() {
	_px_w=$1
	_diag=$2
	_old_ifs=$IFS
	IFS='
'
	for _rule in $AUTO_ADJUST_RULES; do
		IFS=$_old_ifs
		[ -n "$_rule" ] || continue
		_max_zoll=${_rule%%|*}
		_rest=${_rule#*|}
		_min_px=${_rest%%|*}
		_adj=${_rest#*|}
		[ "$_diag" -le "$_max_zoll" ] 2>/dev/null || continue
		[ "$_px_w" -ge "$_min_px" ] 2>/dev/null || continue
		echo "$_adj"
		return
	done
	IFS=$_old_ifs
	echo "$AUTO_ADJUST_FALLBACK"
}

# Rundet einen DPI-Wert auf die naechste empfohlene Stufe
# DPI-Stufen: 96, 120, 144, 168, 192, 240, 288, 336
round_to_dpi_step() {
	raw="$1"
	if [ "$raw" -lt 108 ]; then echo "96"
	elif [ "$raw" -lt 132 ]; then echo "120"
	elif [ "$raw" -lt 156 ]; then echo "144"
	elif [ "$raw" -lt 180 ]; then echo "168"
	elif [ "$raw" -lt 216 ]; then echo "192"
	elif [ "$raw" -lt 264 ]; then echo "240"
	elif [ "$raw" -lt 312 ]; then echo "288"
	else echo "336"
	fi
}

# Skalierungsfaktor basierend auf DPI
calculate_scale_factor() {
	dpi="$1"
	if [ "$dpi" -le 144 ]; then echo "1"
	elif [ "$dpi" -le 192 ]; then echo "1.25"
	elif [ "$dpi" -le 240 ]; then echo "1.5"
	elif [ "$dpi" -le 288 ]; then echo "2"
	elif [ "$dpi" -le 312 ]; then echo "2.5"
	else echo "3"
	fi
}

# === Hauptberechnung ===
# Massgeblich ist immer der Primaerbildschirm.
# Nach einem Wechsel kurz auf EDID-Daten warten (physische Groesse);
# FORCE_DPI braucht keine Erkennung und wartet nicht mit.
[ -n "$FORCE_DPI" ] || wait_for_display_size
info=$(get_display_info)
PRIMARY=$(echo "$info" | cut -d'|' -f1)
RES=$(echo "$info" | cut -d'|' -f2)
PHYS=$(echo "$info" | cut -d'|' -f3)

PX_W=$(echo "$RES" | cut -d'x' -f1)
MM_W=$(echo "$PHYS" | cut -d'm' -f1)
MM_H=$(echo "$PHYS" | cut -d' ' -f3 | cut -d'm' -f1)
DIAGONAL=$(calculate_diagonal "$MM_W" "$MM_H")

# DISPLAY_ADJUST aufloesen: "auto" -> Regel-Tabelle, sonst fester Wert
if [ "$DISPLAY_ADJUST" = "auto" ]; then
	ADJUST=$(auto_adjust "$PX_W" "$DIAGONAL")
else
	ADJUST=$DISPLAY_ADJUST
fi

if [ -n "$FORCE_DPI" ]; then
	MASTER_DPI=$FORCE_DPI
	RAW_DPI="$FORCE_DPI (erzwungen)"
else
	RAW_DPI=$(calculate_raw_dpi "$PX_W" "$MM_W")
	RAW_DPI_ORIG=$RAW_DPI
	# DISPLAY_ADJUST anwenden (Prozent-Offset)
	if [ "$ADJUST" -ne 0 ] 2>/dev/null; then
		RAW_DPI=$(echo "scale=0; $RAW_DPI * (100 + $ADJUST) / 100" | bc 2>/dev/null)
		[ -z "$RAW_DPI" ] && RAW_DPI=$RAW_DPI_ORIG
	fi
	MASTER_DPI=$(round_to_dpi_step "$RAW_DPI")
fi

SCALE_FACTOR=${FORCE_SCALE:-$(calculate_scale_factor "$MASTER_DPI")}

# Mauszeiger-Groesse: 24px Basis, skaliert mit SCALE_FACTOR
XCURSOR_SIZE=$(echo "scale=0; 24 * $SCALE_FACTOR / 1" | bc 2>/dev/null)
XCURSOR_SIZE=${XCURSOR_SIZE:-24}

# === Anwendungs-Funktion ===
apply_dpi() {
	# State-Dateien schreiben
	[ -d "$state_dir" ] || mkdir -p "$state_dir"
	echo "$SCALE_FACTOR" > "$state_dir/scale"
	echo "$MASTER_DPI" > "$state_dir/dpi"
	echo "$XCURSOR_SIZE" > "$state_dir/cursor"
	echo "$DISPLAY_ADJUST" > "$state_dir/adjust"

	# xrandr DPI setzen
	xrandr --dpi "$MASTER_DPI"

	# X-Server Cursor-Grösse sofort übernehmen
	echo "Xcursor.size: $XCURSOR_SIZE" | xrdb -merge 2>/dev/null
	xsetroot -cursor_name left_ptr 2>/dev/null

	# GTK Cursor-Groesse synchronisieren
	gtk3_settings="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
	gtk2_settings="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-2.0/gtkrc-2.0"
	[ -f "$gtk3_settings" ] && sed -i "s/^gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$XCURSOR_SIZE/" "$gtk3_settings"
	[ -f "$gtk2_settings" ] && sed -i "s/^gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$XCURSOR_SIZE/" "$gtk2_settings"

	# gsettings für sofortige GTK-Cursor-Anpassung (laufende GTK3/GTK4-Apps)
	[ -x "$(command -v gsettings)" ] && gsettings set org.gnome.desktop.interface cursor-size "$XCURSOR_SIZE" 2>/dev/null

	# fontconfig DPI synchronisieren
	fontconf="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/fonts.conf"
	[ -f "$fontconf" ] && sed -i "s|<double>[0-9]*</double>|<double>$MASTER_DPI</double>|" "$fontconf"

	# Rofi DPI synchronisieren
	rofi_conf="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi"
	[ -f "$rofi_conf" ] && sed -i "s/dpi: [0-9]*/dpi: $MASTER_DPI/" "$rofi_conf"

	# Umgebungsvariablen exportieren (für Kindprozesse)
	export XCURSOR_SIZE
	export MASTER_DPI
	export SCALE_FACTOR
	export GDK_DPI_SCALE="$SCALE_FACTOR"
	export QT_FONT_DPI="$MASTER_DPI"
	export QT_SCALE_FACTOR="$SCALE_FACTOR"
}

# === DWM-Prozess finden ===
wmpid() {
	tree="$(pstree -ps $$ 2>/dev/null)"
	# Sicherstellen, dass wir wirklich DWM im Baum finden
	if echo "$tree" | grep -q "dwm("; then
		tree="${tree#*dwm(}"
		echo "${tree%%)*}"
	else
		# Fallback, falls wir nicht als Kind von DWM laufen
		pidof dwm 2>/dev/null | awk '{print $1}'
	fi
}

# === Modus-spezifische Ausfuehrung ===
case "$MODE" in
	silent)
		# xprofile-Modus: Alles setzen, keine Ausgabe
		apply_dpi
		;;

	apply)
		# Skript-Modus: Anwenden + kurze Bestaetigung
		apply_dpi
		kill -HUP "$(wmpid)" 2>/dev/null   # Lade den Fenstermanager neu
		echo "DPI=$MASTER_DPI SCALE=$SCALE_FACTOR CURSOR=${XCURSOR_SIZE}px ADJUST=${ADJUST}%"
		;;

	dryrun)
		# Nur anzeigen, nichts aendern
		echo "=== DPI Dry-Run ==="
		echo "Display:        $PRIMARY ($RES, $PHYS)"
		echo "Diagonale:      $DIAGONAL Zoll"
		if [ "$DISPLAY_ADJUST" = "auto" ]; then
			echo "DISPLAY_ADJUST: auto -> ${ADJUST}% (AUTO_ADJUST_RULES)"
		else
			echo "DISPLAY_ADJUST: ${DISPLAY_ADJUST}%"
		fi
		[ -n "$RAW_DPI_ORIG" ] && echo "Hardware-DPI:   $RAW_DPI_ORIG"
		echo "Adjusted-DPI:   $RAW_DPI"
		echo "MASTER_DPI:     $MASTER_DPI"
		echo "SCALE_FACTOR:   $SCALE_FACTOR"
		echo "XCURSOR_SIZE:   $XCURSOR_SIZE"
		;;

	interactive)
		# Interaktiver Modus: Vergleich + Rueckfrage
		echo "=== DPI/SCALE Konfiguration ==="
		echo ""

		# Aktive Displays anzeigen
		echo "Aktive Displays:"
		xrandr 2>/dev/null | grep "connected" | grep -v "disconnected"
		echo ""

		# Details des Primaerbildschirms (identisch zur Berechnung)
		echo "Primär Display:   $PRIMARY"
		echo "  Auflösung:      $RES"
		echo "  Physisch:       $PHYS"
		echo "  Diagonale:      $DIAGONAL Zoll"
		[ -n "$RAW_DPI_ORIG" ] && echo "  Hardware-DPI:   $RAW_DPI_ORIG"

		echo ""
		if [ "$DISPLAY_ADJUST" = "auto" ]; then
			echo "Berechnete Werte (DISPLAY_ADJUST=auto -> ${ADJUST}%):"
		else
			echo "Berechnete Werte (DISPLAY_ADJUST=${DISPLAY_ADJUST}%):"
		fi
		echo "  MASTER_DPI   = $MASTER_DPI"
		echo "  SCALE_FACTOR = $SCALE_FACTOR"
		echo "  XCURSOR_SIZE = $XCURSOR_SIZE"

		# Vergleich mit aktuellen State-Dateien
		if [ -f "$state_dir/dpi" ] && [ -f "$state_dir/scale" ]; then
			old_dpi=$(cat "$state_dir/dpi")
			old_scale=$(cat "$state_dir/scale")
			old_cursor=$(cat "$state_dir/cursor" 2>/dev/null)
			echo ""
			echo "Aktuell aktiv:"
			echo "  DPI:    $old_dpi -> $MASTER_DPI"
			echo "  SCALE:  $old_scale -> $SCALE_FACTOR"
			[ -n "$old_cursor" ] && echo "  CURSOR: $old_cursor -> $XCURSOR_SIZE"

			if [ "$old_dpi" = "$MASTER_DPI" ] && [ "$old_scale" = "$SCALE_FACTOR" ]; then
				echo ""
				echo "Werte sind bereits aktuell, keine Änderungen nötig."
				_setdpi_quit 0
			fi
		fi

		echo ""
		printf "Anwenden? (j/N) "
		read -r answer
		case "$answer" in
			j|J|y|Y)
				apply_dpi
				kill -HUP "$(wmpid)" 2>/dev/null   # Lade den Fenstermanager neu
				echo ""
				echo "Angewandt: DPI=$MASTER_DPI SCALE=$SCALE_FACTOR CURSOR=${XCURSOR_SIZE}px"
				echo "DWM wurde neu gestartet."
				;;
			*)
				echo "Abgebrochen. Keine Änderungen."
				;;
		esac
		;;
esac
