#!/bin/sh
## 2026-07-11   SARBS extra
# Abhängigkeiten: rsync, dunst
# Backup-Skript für SARBS auf verschlüsselten USB-Stick
# Backup der Wichtigsten Dateien laut auswahlliste
# Der Stick muss vorher gemountet werden

# Label des USB-Sticks (bestimmt den Mountpoint-Namen)
LABEL="BAC-STICK"
MOUNTPOINT="/run/media/${USER}/${LABEL}"

# Prüfe ob Stick gemountet ist
if [ ! -d "${MOUNTPOINT}" ]; then
    echo "USB-Stick '${LABEL}' nicht gefunden unter ${MOUNTPOINT}"
    echo "Bitte erst mounten"
    exit 1
fi

# Backup-Verzeichnis (fest, wird wiederverwendet)
BACKUP_DIR="${MOUNTPOINT}/sarbs-backup"
mkdir -p "${BACKUP_DIR}"

notify-send "Backup nach: ${BACKUP_DIR}"

# Rsync ausführen
# Optionen:
#   -r          rekursiv (Verzeichnisse mit Inhalt)
#   -t          Zeitstempel übertragen
#   -p          Berechtigungen (Permissions) übertragen
#   -o          Besitzer (Owner) übertragen
#   -g          Gruppe übertragen
#   -v          verbose (ausführliche Ausgabe)
#   --progress  Fortschritt anzeigen
#   --delete    Dateien löschen die in Quelle nicht mehr existieren
#   -l          Symlinks als Symlinks kopieren
#   -H          Hardlinks erhalten
#   -s          sichere Übertragung (Sonderzeichen in Dateinamen)
sudo rsync \
    -a -v -r --progress --delete -H -s \
    --include="/home/" \
    --include="/home/${USER}/" \
    --include="/home/${USER}/.ssh/***" \
    --include="/home/${USER}/.local/" \
    --include="/home/${USER}/.local/share/" \
    --include="/home/${USER}/.local/share/mail/***" \
    --include="/home/${USER}/.local/share/pass/***" \
    --include="/home/${USER}/.local/share/gnupg/***" \
    --include="/home/${USER}/.local/src/***" \
    --include="/home/${USER}/Bilder/" \
    --include="/home/${USER}/Bilder/***" \
    --exclude="*" \
    / "${BACKUP_DIR}"

# Sicherstellen, dass alle Daten auf die Festplatte geschrieben wurden
sync

notify-send "Backup abgeschlossen"
