# --- Einzelner Monitor aufnehmen (nur Video, ohne Ton) ---
screencast_monitor() {
    # Monitor auswählen (verwendet select_monitor für konsistente Geometrie)
    local monitor_data
    monitor_data="$(select_monitor)" || return 1

    local selected_monitor resolution x_offset y_offset offset=""
    selected_monitor="$(echo "$monitor_data" | cut -d'|' -f1)"
    resolution="$(echo "$monitor_data" | cut -d'|' -f2)"
    x_offset="$(echo "$monitor_data" | cut -d'|' -f3)"
    y_offset="$(echo "$monitor_data" | cut -d'|' -f4)"
    offset="+${x_offset}+${y_offset}"

    local out="$VIDEO_DIR/monitor-${selected_monitor}-$(date '+%y%m%d-%H%M-%S').$VIDEO_FORMAT"

    check_hw_encoder

    local vf_flag=""
    if [ -n "$VF_UPLOAD" ]; then
        vf_flag="-vf $VF_UPLOAD"
    fi

    nice -n -10 ffmpeg -y \
        $HW_ACCEL_INIT \
        -thread_queue_size "$THREAD_QUEUE" \
        -f x11grab -framerate "$FRAMERATE" -video_size "$resolution" -i "$DISPLAY$offset" \
        $vf_flag \
        -c:v "$VIDEO_CODEC" $ENCODE_PARAMS \
        -an \
        "$out" &
    echo $! > /tmp/recordingpid
    notify "Monitor-Aufnahme: $selected_monitor (ohne Ton)"
    updateicon "$ICON_MONITOR"
}

# --- Reaction: Bildschirm + Mikrofon + System-Audio (separate Spuren) ---
screencast_reaction() {
    local mic sys_audio
    mic=$(detect_microphone) || return 1
    sys_audio=$(detect_system_audio) || return 1

    local resolution display_input out monitor_data

    # DEV: Prüfung auf mehrere Monitore
    local monitor_count
    monitor_count=$(count_active_monitors)

    if [ "$monitor_count" -gt 1 ]; then
        # Mehrere Monitore: Auswahl anzeigen
        monitor_data="$(select_monitor)" || return 1
        resolution="$(echo "$monitor_data" | cut -d'|' -f2)"
        local x_offset y_offset
        x_offset="$(echo "$monitor_data" | cut -d'|' -f3)"
        y_offset="$(echo "$monitor_data" | cut -d'|' -f4)"
        display_input="${DISPLAY}+${x_offset}+${y_offset}"
    else
        # Einzelner Monitor: Gesamten Bildschirm aufnehmen
        resolution=$(get_primary_monitor_resolution)
        display_input="$DISPLAY"
    fi

    # ALT: Immer gesamten Bildschirm
    # local resolution
    # resolution=$(get_primary_monitor_resolution)
    local out="$VIDEO_DIR/reaction-$(date '+%y%m%d-%H%M-%S').$VIDEO_FORMAT"

    # Sicherstellen, dass System-Audio nicht stumm ist
    pactl set-source-mute "$sys_audio" 0 2>/dev/null

    check_hw_encoder

    # Zwei separate Audiospuren: Spur 1 = Mikrofon, Spur 2 = System-Audio
    local vf_flag map_params
    if [ -n "$VF_UPLOAD" ]; then
        vf_flag="-vf ${VF_UPLOAD}"
        map_params="-map 0:v -map 1:a -map 2:a"
    else
        vf_flag=""
        map_params="-map 0:v -map 1:a -map 2:a"
    fi

    nice -n -10 ffmpeg -y \
        $HW_ACCEL_INIT \
        -itsoffset -0.225 \
        -thread_queue_size "$THREAD_QUEUE" \
        -f x11grab -framerate "$FRAMERATE" -video_size "$resolution" -i "$display_input" \
        -thread_queue_size "$THREAD_QUEUE" \
        -f pulse -sample_rate "$AUDIO_SAMPLERATE" -channels 2 -i "$mic" \
        -thread_queue_size "$THREAD_QUEUE" \
        -f pulse -sample_rate "$AUDIO_SAMPLERATE" -channels 2 -i "$sys_audio" \
        $vf_flag \
        $map_params \
        -c:v "$VIDEO_CODEC" $ENCODE_PARAMS \
        -c:a:0 "$AUDIO_CODEC" -ar "$AUDIO_SAMPLERATE" \
        -c:a:1 "$AUDIO_CODEC" -ar "$AUDIO_SAMPLERATE" \
        "$out" &

    echo $! > /tmp/recordingpid
    notify "Reaction gestartet (Mikrofon + System-Audio getrennt)"
    updateicon "$ICON_REACTION"
    start_reclevel "$mic" "$sys_audio"
}

# --- Stream (YouTube / 2x Twitch), optional mit lokaler Aufnahme ---
stream_screencast() {
    local mic sys_audio
    mic=$(detect_microphone) || return 1
    sys_audio=$(detect_system_audio) || return 1

    local resolution display_input monitor_data

    # DEV: Prüfung auf mehrere Monitore
    local monitor_count
    monitor_count=$(count_active_monitors)

    if [ "$monitor_count" -gt 1 ]; then
        # Mehrere Monitore: Auswahl anzeigen
        monitor_data="$(select_monitor)" || return 1
        resolution="$(echo "$monitor_data" | cut -d'|' -f2)"
        local x_offset y_offset
        x_offset="$(echo "$monitor_data" | cut -d'|' -f3)"
        y_offset="$(echo "$monitor_data" | cut -d'|' -f4)"
        display_input="${DISPLAY}+${x_offset}+${y_offset}"
    else
        # Einzelner Monitor: Gesamten Bildschirm aufnehmen
        resolution=$(get_primary_monitor_resolution)
        display_input="$DISPLAY"
    fi

    # Sicherstellen, dass System-Audio nicht stumm ist
    pactl set-source-mute "$sys_audio" 0 2>/dev/null

    check_hw_encoder

    # RTMP braucht H.264 und AAC
    if [ "$VIDEO_CODEC" = "hevc_vaapi" ]; then
        VIDEO_CODEC="h264_vaapi"
    fi
    local stream_audio_codec="aac"

    # Besseres Keyhandling überlegen.
    # Stream Keys
    local yt_key tw_key tw2_key
    yt_key="$(cat ~/.local/share/yt/stream-key 2>/dev/null)"
    tw_key="$(cat ~/.local/share/twitch/stream-key 2>/dev/null)"
    # tw2_key="$(cat ~/.local/share/twitch/stream-key-2 2>/dev/null)"

    if [ -z "$yt_key" ] && [ -z "$tw_key" ] && [ -z "$tw2_key" ]; then
        notify "Keine Stream-Keys gefunden (YT/Twitch)!"
        return 1
    fi

    local rtmp_opts="select='v\:0\,a\:0':f=flv:onfail=ignore"
    local tee_outputs=""

    if [ -n "$yt_key" ]; then
        tee_outputs="${tee_outputs}[${rtmp_opts}]rtmp://x.rtmp.youtube.com/live2/${yt_key}|"
    fi
    if [ -n "$tw_key" ]; then
        tee_outputs="${tee_outputs}[${rtmp_opts}]rtmp://live.twitch.tv/app/${tw_key}|"
    fi
    if [ -n "$tw2_key" ]; then
        tee_outputs="${tee_outputs}[${rtmp_opts}]rtmp://live.twitch.tv/app/${tw2_key}|"
    fi

    # Optionale lokale Aufnahme: matroska mit separaten Mikro/System-Spuren (Spur 2 & 3)
    local extra_maps=""
    if [ "$STREAM_LOCAL_REC" = "1" ]; then
        local out="$VIDEO_DIR/stream-$(date '+%y%m%d-%H%M-%S').$VIDEO_FORMAT"
        local rec_opts="select='v\:0\,a\:1\,a\:2':f=matroska"
        tee_outputs="${tee_outputs}[${rec_opts}]${out}"
        extra_maps="-map 1:a -map 2:a"
    else
        tee_outputs="${tee_outputs%|}"
    fi

    # Filter-Complex: Audio mixen (Spur 1)
    local filter_complex map_params
    if [ -n "$VF_UPLOAD" ]; then
        filter_complex="-filter_complex [1:a]volume=1.0[mic];[2:a]volume=0.8[sys];[mic][sys]amix=inputs=2:duration=longest[aout];[0:v]${VF_UPLOAD}[vout]"
        map_params="-map [vout] -map [aout] $extra_maps"
    else
        filter_complex="-filter_complex [1:a]volume=1.0[mic];[2:a]volume=0.8[sys];[mic][sys]amix=inputs=2:duration=longest[aout]"
        map_params="-map 0:v -map [aout] $extra_maps"
    fi

    local audio_codecs="-c:a:0 $stream_audio_codec -ar $AUDIO_SAMPLERATE -b:a:0 160k"
    if [ "$STREAM_LOCAL_REC" = "1" ]; then
        audio_codecs="${audio_codecs} -c:a:1 $stream_audio_codec -ar $AUDIO_SAMPLERATE -b:a:1 256k -c:a:2 $stream_audio_codec -ar $AUDIO_SAMPLERATE -b:a:2 256k"
    fi

    nice -n -10 ffmpeg -y \
        $HW_ACCEL_INIT \
        -itsoffset -0.225 \
        -thread_queue_size "$THREAD_QUEUE" \
        -f x11grab -framerate "$FRAMERATE" -video_size "$resolution" -i "$display_input" \
        -thread_queue_size "$THREAD_QUEUE" \
        -f pulse -sample_rate "$AUDIO_SAMPLERATE" -channels 2 -i "$mic" \
        -thread_queue_size "$THREAD_QUEUE" \
        -f pulse -sample_rate "$AUDIO_SAMPLERATE" -channels 2 -i "$sys_audio" \
        $filter_complex \
        $map_params \
        -c:v "$VIDEO_CODEC" $ENCODE_PARAMS \
        -flags +global_header \
        $audio_codecs \
        -f tee "$tee_outputs" &

    echo $! > /tmp/recordingpid

    local targets=""
    [ -n "$yt_key" ]  && targets="${targets}YT "
    [ -n "$tw_key" ]  && targets="${targets}Twitch "
    [ -n "$tw2_key" ] && targets="${targets}Twitch2 "
    notify "Stream gestartet (${targets% })"
    updateicon "$ICON_SCREENCAST"
    start_reclevel "$mic" "$sys_audio"
}

# --- Reine Audioaufnahme (Mikrofon) ---
audio() {
    local mic
    mic=$(detect_microphone) || return 1

    local out="$AUDIO_DIR/audio-$(date '+%y%m%d-%H%M-%S').$AUDIO_FORMAT"
    ffmpeg -f pulse -i "$mic" -c:a "$AUDIO_CODEC" "$out" &
    echo $! > /tmp/recordingpid
    notify "Audioaufnahme gestartet (Mikrofon)"
    updateicon "$ICON_AUDIO"
    start_reclevel "$mic"
}

# --- Webcamaufnahme (Mikrofon) ---
webcam() {
    local mic
    mic=$(detect_microphone) || return 1

    local out="$VIDEO_DIR/webcam-$(date '+%y%m%d-%H%M-%S').$VIDEO_FORMAT"

    # Verfügbare Webcams
    local devices
    devices=$(ls /dev/video* 2>/dev/null)
    if [ -z "$devices" ]; then
        notify "Keine Webcam gefunden"
        return 1
    fi

    # Webcam auswählen wenn mehrere vorhanden
    local webcam
    if [ "$(echo "$devices" | wc -l)" -gt 1 ]; then
        webcam=$(echo "$devices" | rofi_menu -p "Webcam auswählen")
        if [ -z "$webcam" ]; then
            notify "Keine Webcam ausgewählt"
            return 1
        fi
    else
        webcam="$devices"
    fi

    local resolution="640x480"

    check_hw_encoder

    # Webcam: Reduzierte Bitrate
    local webcam_encode_params
    if [[ "$VIDEO_CODEC" == "libx264" ]]; then
        webcam_encode_params="-preset medium -crf 23 -b:v 2M -g $GOP_SIZE"
    elif [[ "$VIDEO_CODEC" == *"vaapi"* ]]; then
        webcam_encode_params="-rc_mode CBR -b:v 2M -maxrate 3M -bufsize 4M -g $GOP_SIZE"
    elif [[ "$VIDEO_CODEC" == *"nvenc"* ]]; then
        webcam_encode_params="-preset ${NVENC_PRESET:-medium} -tune ${NVENC_TUNE:-hq} -crf ${NVENC_CRF:-23} -b:v 2M"
    else
        webcam_encode_params="-b:v 2M"
    fi

    local vf_flag=""
    if [ -n "$VF_UPLOAD" ]; then
        vf_flag="-vf $VF_UPLOAD"
    fi

    ffmpeg -y \
        $HW_ACCEL_INIT \
        -thread_queue_size "$THREAD_QUEUE" \
        -f v4l2 -i "$webcam" -video_size "$resolution" \
        -thread_queue_size "$THREAD_QUEUE" \
        -f pulse -sample_rate "$AUDIO_SAMPLERATE" -channels 2 -i "$mic" \
        $vf_flag \
        -c:v "$VIDEO_CODEC" $webcam_encode_params \
        -c:a "$AUDIO_CODEC" -ar "$AUDIO_SAMPLERATE" \
        "$out" &

    echo $! > /tmp/recordingpid
    notify "Webcamaufnahme gestartet (Mikrofon)"
    updateicon "$ICON_WEBCAM"
    start_reclevel "$mic"
}

# ══════════════════════════════════════════════════════════════════════════════
# [8] ROFI-MENÜ
# ══════════════════════════════════════════════════════════════════════════════

# Menü-Befehl definieren (Zentrale Stelle für einfache Anpassungen)
rofi_menu() {
    rofi -dmenu -i -location 0 -theme-str 'window { width: 35%; } listview { lines: 7; }' "$@"
}

askrecording() {
    local choice
    choice="$(printf "Bildschirm + Systemton\nBildschirm + Mikrofon\nMonitor wählen (ohne Ton)\nReaktion (Mikro + Systemton)\nStream (YT/Twitch)\nAudioaufnahme\nWebcam" \
        | rofi_menu -p "Aufnahme starten")"
    case "$choice" in
        "Bildschirm + Systemton")        screencast_system ;;
        "Bildschirm + Mikrofon")         screencast_mic ;;
        "Monitor wählen (ohne Ton)")     screencast_monitor ;;
        "Reaktion (Mikro + Systemton)")  screencast_reaction ;;
        "Stream (YT/Twitch)")            stream_screencast ;;
        Audioaufnahme)                   audio ;;
        Webcam)                          webcam ;;
        *) notify "Keine Auswahl getroffen" ;;
    esac
}

asktoend() {
    local response
    response="$(printf "Ja\nNein" | rofi_menu -p "Aufnahme läuft, beenden?")"
    [ "$response" = "Ja" ] && killrecording
}

# ══════════════════════════════════════════════════════════════════════════════
# [9] INITIALISIERUNG & HAUPTLOGIK
# ══════════════════════════════════════════════════════════════════════════════

# Abhängigkeiten prüfen
if ! command -v ffmpeg &> /dev/null; then
    notify "ffmpeg ist nicht installiert."
    exit 1
fi

if ! command -v rofi &> /dev/null; then
    notify "rofi ist nicht installiert."
    exit 1
fi

# Verzeichnisse sicherstellen
[ ! -d "$VIDEO_DIR" ] && mkdir -p "$VIDEO_DIR" && notify "Video-Verzeichnis erstellt: $VIDEO_DIR"
[ ! -d "$AUDIO_DIR" ] && mkdir -p "$AUDIO_DIR" && notify "Audio-Verzeichnis erstellt: $AUDIO_DIR"

# GPU erkennen und Profil laden
GPU_TYPE=$(detect_gpu)
load_gpu_profile "$GPU_TYPE"

# Hauptlogik
case "$1" in
    _reclevel_mon)      _reclevel_mon "$2" ;;
    _reclevel_mon_dual) _reclevel_mon_dual "$2" "$3" ;;
    system)   screencast_system ;;
    mic)      screencast_mic ;;
    monitor)  screencast_monitor ;;
    reaction) screencast_reaction ;;
    stream)   stream_screencast ;;
    audio)    audio ;;
    webcam)   webcam ;;
    kill)     killrecording ;;
    *)
        ([ -f /tmp/recordingpid ] && asktoend) || askrecording
        ;;
esac
