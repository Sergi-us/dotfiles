#         [ -z "$prim_sel" ] && return 1
#         primary=$(echo "$prim_sel" | awk '{print $2}')
#         local sec_sel=$(echo "$formatted" | grep -v "$primary")
#         secondary=$(echo "$sec_sel" | awk '{print $2}')
#         direction=$(printf "links\\nrechts\\noben\\nunten" | rofi_menu -p "Auf welcher Seite von $primary soll $secondary sein?")
#         [ -z "$direction" ] && return 1
#         case "$direction" in
#             "links") pos_arg="--left-of $primary" ;;
#             "rechts") pos_arg="--right-of $primary" ;;
