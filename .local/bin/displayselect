postrun() { # Aufräumen nach Display-Wechsel
	# DEV: Warteschleifen auf EDID-Daten - auskommentiert erhalten.
	# Erkenntnis aus den Messungen 2026-09-08: Beide Varianten waren
	# wirkungslos, unnoetig und teuer.
	# - Wirkungslos: Abbruch sobald IRGENDEIN verbundener Output Aufloesung und
	#   mm meldet. Das ist unmittelbar nach dem Wechsel der Fall, im Zweifel
	#   auch schon vorher - gewartet wird also praktisch nie.
	# - Unnoetig: "xrandr --output ... --mode ..." ist synchron. Kehrt xrandr
	#   zurueck, ist der neue Modus aktiv und die mm-Angabe steht in der
	#   Output-Zeile.
	# - Teuer: im schlechtesten Fall 10 Sekunden, in denen der halb gesetzte
	#   Zustand sichtbar bleibt.
	# Falls je wieder gewartet werden muss: auf den ZIEL-Output pruefen und die
	# physische Groesse vorab aus dem EDID holen ("xrandr --prop", Bytes 21/22
	# in cm). Die steht auch fuer inaktive Outputs bereit, also schon bevor
	# umgeschaltet wird - damit lassen sich Aufloesung UND mm vorab kennen.
	# sleep 2
	# _wait=0
	# while [ "$_wait" -lt 10 ]; do
	# 	if xrandr 2>/dev/null | grep " connected" | grep -E '[0-9]+x[0-9]+\+[0-9]+' | grep -q '[0-9]*mm x [0-9]*mm'; then
	# 		break
	# 	fi
	# 	sleep 1
	# 	_wait=$((_wait + 1))
	# done

	# DPI und Skalierung neu berechnen für das neue Display-Setup.
	# NO_WM_RELOAD=1: set-dpi laedt dwm nicht selbst neu, das passiert hier
	# ganz am Ende, wenn Hintergrundbild und Farben (xrdb) stehen.
	# DEV: Alter Ansatz - auskommentiert erhalten.
	# Problem: set-dpi -a schickte SIGHUP an dwm. dwm beendet run() aber erst
	# beim naechsten X-Event, der Neustart landete dadurch mitten in setbg
	# (hellwal braucht ~1,4 s): dwm startete vor dem neuen Hintergrundbild und
	# mit den alten Farben in xrdb neu.
	# dpi_result=$(set-dpi -a)
	if [ -x "$(command -v set-dpi)" ]; then
		dpi_result=$(NO_WM_RELOAD=1 set-dpi -a)
	fi

	# Hintergrund neu setzen (nach DPI, nutzt neue Skalierung)
	# DEV: Alter Ansatz - auskommentiert erhalten.
	# Problem: "setbg -s" ohne Dateiargument laeuft ueber einen unbeabsichtigten
	# Pfad: readlink -f '' scheitert, dadurch wird der komplette case-Block in
	# setbg uebersprungen (Symlink-Pruefung, bgmsg). Dass danach trotzdem
	# xwallpaper laeuft, ist reiner Zufall. Zusaetzlich war bei einem
	# Aufloesungswechsel klein -> gross kein Hintergrundbild sichtbar, erst ein
	# manuelles setbg half. Explizite Uebergabe des Hintergrund-Links macht den
	# Code-Pfad in setbg eindeutig: Datei wird erkannt, Symlink bestaetigt und
	# xwallpaper laeuft mit der neuen Bildschirmgroesse.
	# setbg -s >/dev/null 2>&1
	_bglink="${XDG_DATA_HOME:-$HOME/.local/share}/bg"
	# Keine Umleitung mehr (AGENTS.md, kein /dev/null-Nirvana): setbg ist im
	# Silent-Modus auf stdout ohnehin still. Fehler von xwallpaper oder hellwal
	# sollen sichtbar bleiben - im Terminal, und bei Start ueber ein Binding im
	# startx-Terminal, von dem dwm stdout/stderr geerbt hat.
	# setbg -s >/dev/null 2>&1
	# setbg -s "$_bglink" >/dev/null
	setbg -s "$_bglink"

	# Dunst neustarten für korrekte Bildschirmposition.
	# DEV: Alter Ansatz - auskommentiert erhalten.
	# Problem 1: "dunst & >/dev/null 2>&1" - das "&" beendet den Befehl, die
	#            Umleitungen danach sind ein eigener Befehl und verbiegen
	#            stdout/stderr der aktuellen Shell. Alles, was in postrun
	#            danach kam, war damit stummgeschaltet.
	# Problem 2: "dunstctl close-all" beendet dunst nicht. Der gewuenschte
	#            Neustart fuer die neue Geometrie fand also nie statt, der
	#            zusaetzliche Start kollidierte mit dem dunst, den
	#            hellwal/postrun bereits gestartet hat:
	#            "CRITICAL: Cannot acquire org.freedesktop.Notifications".
	# if [ -x "$(command -v dunstctl)" ]; then
	# 	dunstctl close-all
	# else
	# 	killall -q dunst
	# fi
	# dunst & >/dev/null 2>&1
	if [ -x "$(command -v dunstctl)" ]; then
		dunstctl close-all      # alte Benachrichtigungen verwerfen
	fi
	killall -q dunst              # beenden, damit die neue Geometrie gilt
	sleep 0.2
	# Nur starten, wenn wirklich kein dunst laeuft - sonst kaempfen zwei
	# Instanzen um den DBus-Namen. pidof wird nur ueber den Exit-Status
	# benutzt, dessen Ausgabe darf verworfen werden (AGENTS.md, Ausnahme 2).
	# dunst lebt laenger als dieses Skript, deshalb Logdatei statt /dev/null
	# (AGENTS.md, Ausnahme 3).
	# pidof dunst >/dev/null 2>&1 || setsid -f dunst >/dev/null 2>&1
	_dunstlog="${XDG_STATE_HOME:-$HOME/.local/state}/xsession/dunst.log"
	[ -d "${_dunstlog%/*}" ] || mkdir -p "${_dunstlog%/*}"
	pidof dunst >/dev/null 2>&1 || setsid -f dunst >>"$_dunstlog" 2>&1

	# dwm zuletzt neu laden: DPI, Hintergrundbild und die von hellwal in xrdb
	# gemergten Farben stehen jetzt bereit, dwm startet genau einmal mit dem
	# fertigen Stand. pidof kann mehrere PIDs liefern, daher bewusst ohne
	# Anfuehrungszeichen (Wortaufteilung gewollt).
	_wmpid=$(pidof dwm 2>/dev/null)
	if [ -n "$_wmpid" ]; then
		kill -HUP $_wmpid
	else
		echo "displayselect: WARNUNG - dwm nicht gefunden, Fenstermanager nicht neu geladen." >&2
	fi

	# Benachrichtigung NACH allem senden
	[ -n "$dpi_result" ] && notify-send "Display-Einstellungen aktualisiert" "$dpi_result"

	# Sicherheitsnetz mit 5 Sekunden Verzoegerung: Hintergrundbild erneut setzen.
	# Der Aufruf schadet nicht, es wird dasselbe Bild gesetzt, und er faengt den
	# Fall ab, dass Bild und Compositor beim Umschalten nicht zusammengespielt
	# haben. Subshell mit "&", damit postrun nicht fuenf Sekunden blockiert.
	# Bewusst ohne -s: Die Benachrichtigung zeigt in der Testphase, dass der
	# Nachschlag gelaufen ist. Fuer Dauerbetrieb auf "setbg -s" umstellen.
	( sleep 5; setbg "$_bglink" ) &
	}

# Alle verfügbaren Ausgänge erfassen
allposs=$(echo "$XRANDR_OUT" | grep "connected")

# Alle tatsächlich verbundenen Bildschirme
screens=$(echo "$allposs" | awk '/ connected/ {print $1}')

# Falls kein Bildschirm erkannt wurde (Fehlerfall/Headless)
[ -z "$screens" ] && exit 1

# Wenn es nur einen Bildschirm gibt
[ "$(echo "$screens" | wc -l)" -lt 2 ] &&
	{ onescreen "$screens" "$allposs" && { postrun; notify-send "󰍹  Nur ein Bildschirm erkannt." "Nutze ihn in optimalen Einstellungen..."; }; exit ;}

# DEV (neu): Bildschirm unter der Maus einmalig beim Start ermitteln.
# In DWM erscheint Rofi auf dem fokussierten Monitor (= Mausposition), damit
# entfällt bei der Auflösungsänderung die Zwischenfrage "Welcher Bildschirm?".
mouse_screen=$(get_mouse_screen)
if [ -n "$mouse_screen" ]; then
	res_menu_entry="Auflösung von $mouse_screen ändern"
else
	# Fallback falls xdotool fehlt oder die Erkennung fehlschlägt
	res_menu_entry="Auflösung ändern (manuelle Auswahl)"
fi

# Menü-Einträge für einzelne Bildschirme mit Monitordaten vorbereiten.
# get_formatted_screens liefert pro Output Nummer, Name, aktuelle Auflösung,
# Diagonale in Zoll und den Monitor-Namen aus dem EDID - auch für inaktive
# Outputs. Damit ist im ersten Menü erkennbar, welcher Eintrag welcher
# Bildschirm ist, ohne dass erst umgeschaltet werden muss.
# DEV: Alter Ansatz - auskommentiert erhalten. Der Suffix allein sagt nichts
# über den Bildschirm aus, die EDID-Daten waren zwar schon verfügbar, wurden
# hier aber nicht benutzt. Feld 1 war der Output-Name, jetzt steht dort die
# Nummer - die Auswertung unten im case-Zweig ist entsprechend angepasst.
# single_screens_menu=$(echo "$screens" | awk '{print $1 " (nur dieser Bildschirm)"}')
single_screens_menu=$(get_formatted_screens "$screens")

# Benutzerauswahl inkl. Multi-Monitor und manueller Auswahl:
chosen_menu=$(printf "Mehrere Bildschirme einrichten\n%s\n%s\nManuelle Auswahl (ARANDR)" "$single_screens_menu" "$res_menu_entry" | rofi_menu -p "Wähle Anzeigemodus:") &&
case "$chosen_menu" in
	"Manuelle Auswahl (ARANDR)") arandr && postrun ;;
	# DEV: lief früher über multimon, das zu twoscreen/morescreen verzweigte.
	# morescreen behandelt nun 2+ Bildschirme einheitlich.
	"Mehrere Bildschirme einrichten") morescreen "$screens" && postrun ;;
	"$res_menu_entry")
		target="$mouse_screen"
		# Fallback: manuelle Bildschirmwahl, wenn Automatik fehlgeschlagen ist
		if [ -z "$target" ]; then
			sel=$(get_formatted_screens "$screens" | rofi_menu -p "Auflösung von welchem Bildschirm ändern?")
			[ -n "$sel" ] || exit
			target=$(echo "$sel" | awk '{print $2}')
		fi
		change_resolution "$target" && postrun
		;;
	*)
		# Einzelbildschirm-Eintrag: Format "1: HDMI-1 (3840x2160, 27 Zoll, LS27D70xE)".
		# Der Output-Name steht in Feld 2, Feld 1 ist die Nummer.
		# chosen=$(echo "$chosen_menu" | awk '{print $1}')
		chosen=$(echo "$chosen_menu" | awk '{print $2}')
		onescreen "$chosen" "$allposs" && postrun
		;;
esac
