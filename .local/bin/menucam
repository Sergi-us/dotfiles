#!/bin/sh
## 2025-02-10 SARBS
# Abhängigkeiten: GNU Coreutils (cut, nice), awk, bc, notify-send, rofi, v4l2-ctl
# Webcam-Script mit Rofi-Abfrage

# Konfigurationsvariablen
PIXELFORMAT="MJPG"
ASPECT_RATIO="9:12"

# Reduzierte GPU-Optionen für mpv
MPV_BASE_OPTIONS="--untimed --no-cache --no-osc --no-input-default-bindings --profile=low-latency --input-conf=/dev/null --title=webcam"
STANDARD_FILTERS="hflip"
ANDROID_FILTERS="rotate=PI/2,hue=s=0,hflip,vflip"
ANDROID_ROTATION=""

# HINWEIS ZU MEHREREN DEVICES PRO KAMERA:
# Es ist normal, dass eine Webcam mehrere /dev/video* Nodes erstellt.
# Grund ist der Video4Linux2 (V4L2) Treiber:
# - video0: Meist der 'Video Capture Node' (Der echte Bild-Stream für mpv).
# - video1: Meist der 'Metadata Node' (z.B. für Hardware-Autofokus oder Belichtung).
#           Hier schlägt mpv fehl, da es keine echten Bilddaten sind.
# Wir listen bewusst alle auf, falls der Capture-Node abweicht.

# Abhängigkeiten prüfen
for cmd in v4l2-ctl mpv rofi bc; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        notify-send -u critical "Fehlende Abhängigkeit" "Bitte installiere '$cmd' für das Webcam-Skript."
        exit 1
    fi
done

# Funktion zum Auflisten aller verfügbaren Videogeräte mit bereinigtem Namen
list_video_devices() {
    # v4l2-ctl listet Geräte im Format:
    # Integrated Camera: Integrated C (usb-0000:07:00.4-2.1):
    #         /dev/video0
    # Wir extrahieren den Namen VOR der Klammer (usb-...)
    v4l2-ctl --list-devices | awk '
        /^\t\/dev\/video/ { if(name != "") print $1 " [" name "]" }
        /^[^[:space:]]/ {
            name=$0;
            # Entferne den (usb-...) Teil und den nachfolgenden Doppelpunkt
            sub(/ \([^\)]+\):?$/, "", name);
            # Falls am Ende noch ein Doppelpunkt ist, auch den entfernen
            sub(/:$/, "", name);
        }
    '
}

# Funktion zum Überprüfen, ob ein Gerät eine Android Webcam ist
is_android_webcam() {
    v4l2-ctl --device="$1" --all 2>/dev/null | grep -q "Android Webcam"
}

# Zentrale Rofi-Menü Definition
rofi_menu() {
    rofi -dmenu -i -location 0 -theme-str 'window { width: 50%; } listview { lines: 5; }' "$@"
}

# Geräte auflisten und Auswahl treffen
selected=$(list_video_devices | rofi_menu -p "Wähle Webcam:")

[ -z "$selected" ] && exit 0

# Extrahiere nur den /dev/video Pfad (das erste Wort)
DEVICE=$(echo "$selected" | awk '{print $1}')

# Konfiguriere das Gerät basierend auf dem Typ
if is_android_webcam "$DEVICE"; then
    FILTERS=$ANDROID_FILTERS
    ROTATION=$ANDROID_ROTATION
    IS_ANDROID=1
else
    FILTERS=$STANDARD_FILTERS
    ROTATION=""
    IS_ANDROID=0
fi

# Maximale Auflösung für das Pixelformat finden
SQ="'"
MAX_RES=$(v4l2-ctl --list-formats-ext --device="$DEVICE" 2>/dev/null | awk -v fmt="$SQ$PIXELFORMAT$SQ" '
    /\[.*\]:/ {
        in_format = (index($0, fmt) > 0)
    }
    in_format && /Size: Discrete/ {
        split($3, dim, "x")
        pixels = dim[1] * dim[2]
        if (pixels > max_pixels) {
            max_pixels = pixels
            max_w = dim[1]
            max_h = dim[2]
        }
    }
    END { if (max_w) print max_w "x" max_h }
')

if [ -z "$MAX_RES" ]; then
    notify-send -u critical "Fehler" "Keine unterstützte Auflösung für Pixelformat '$PIXELFORMAT' gefunden."
    exit 1
fi

WIDTH=$(echo "$MAX_RES" | cut -d'x' -f1)
HEIGHT=$(echo "$MAX_RES" | cut -d'x' -f2)

# Effektive Dimensionen nach Rotation (Android: Breite/Höhe vertauscht)
if [ "$IS_ANDROID" -eq 1 ]; then
    EFF_W=$HEIGHT
    EFF_H=$WIDTH
else
    EFF_W=$WIDTH
    EFF_H=$HEIGHT
fi

# Aspect-Ratio-Crop berechnen (zentriert, gerade Dimensionen)
if [ -n "$ASPECT_RATIO" ]; then
    AR_W=$(echo "$ASPECT_RATIO" | cut -d':' -f1)
    AR_H=$(echo "$ASPECT_RATIO" | cut -d':' -f2)

    CROP_W=$(echo "$EFF_H * $AR_W / $AR_H / 2 * 2" | bc)

    if [ "$CROP_W" -lt "$EFF_W" ]; then
        FILTERS="${FILTERS},crop=${CROP_W}:${EFF_H}"
    elif [ "$CROP_W" -gt "$EFF_W" ]; then
        CROP_H=$(echo "$EFF_W * $AR_H / $AR_W / 2 * 2" | bc)
        FILTERS="${FILTERS},crop=${EFF_W}:${CROP_H}"
    fi
fi

notify-send "Starte Webcam" "Kamera: $DEVICE\nAuflösung: ${WIDTH}x${HEIGHT}\nSeitenverhältnis: ${ASPECT_RATIO:-nativ}\nFilter: ${FILTERS}"

# Vorherige mpv-Instanzen beenden
pkill -f "mpv.*$DEVICE" 2>/dev/null

# Pixelformat für ffmpeg/mpv mappen
case "$PIXELFORMAT" in
    MJPG) FFMPEG_FORMAT="mjpeg" ;;
    *) FFMPEG_FORMAT=$(echo "$PIXELFORMAT" | tr '[:upper:]' '[:lower:]') ;;
esac

# Starte MPV mit den konfigurierten Optionen
nice -n 10 mpv $MPV_BASE_OPTIONS ${ROTATION:+"$ROTATION"} --demuxer-lavf-o="video_size=${WIDTH}x${HEIGHT}" --demuxer-lavf-o="input_format=${FFMPEG_FORMAT}" --vf="$FILTERS" "$DEVICE" >/dev/null 2>&1
